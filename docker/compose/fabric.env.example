# Secret NAMES and local development values for the fabric plane.
# Never commit real values (ADR-0015). The Compose file refuses to start
# without the three passwords below, because a default password on an identity
# provider is worse than no identity provider.

FABRIC_DB_USER=fabric
FABRIC_DB_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Dev-mode Vault only. This is not a secret and never becomes one.
VAULT_DEV_TOKEN=orgagents-dev-root

FABRIC_HTTP_PORT=80
KEYCLOAK_PORT=8081
GRAFANA_PORT=3000
JAEGER_UI_PORT=16686

ORGAGENTS_FABRIC_BASE_URL=http://localhost
ORGAGENTS_COMMAND_BASE_URL=http://localhost/command/
ORGAGENTS_FABRIC_AUTH=trusted_proxy

# Forward auth (oauth2-proxy against Keycloak). The cookie secret is 32 random
# bytes, base64: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
OAUTH2_PROXY_CLIENT_ID=orgagents
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=
ORGAGENTS_PROXY_SECRET=
