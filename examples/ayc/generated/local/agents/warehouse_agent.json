        "id": "purchasing_and_payment",
        "decisions": [
          "raise_po",
          "pay_invoice"
        ],
        "reason": "A buyer who both raises the purchase order and pays the invoice can pay a supplier that does not exist. Purchasing raises; Finance pays."
      },
      {
        "id": "inventory_and_fulfillment",
        "decisions": [
          "adjust_inventory",
          "fulfill_order"
        ],
        "reason": "Whoever ships the goods must not also adjust the count, or shrinkage disappears into an \"adjustment\". The cycle count is independent of the dock."
      },
      {
        "id": "refund_and_receivable",
        "decisions": [
          "issue_refund",
          "record_receivable"
        ],
        "reason": "Issuing a refund and clearing the receivable it should offset, in one hand, is how money leaves without a trail."
      }
    ],
