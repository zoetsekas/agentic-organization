        "id": "inventory_and_fulfillment",
        "decisions": [
          "adjust_inventory",
          "fulfill_order"
        ],
        "reason": "Whoever ships the goods must not also adjust the count, or shrinkage disappears into an \"adjustment\". The cycle count is independent of the dock."
      },
