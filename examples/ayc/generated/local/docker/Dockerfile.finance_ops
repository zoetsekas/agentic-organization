# Generated by orgagents from the system spec 'ayc' (spec_version 1.4.0, ir 1.0.0).
# Do not edit: this file is regenerated on every compile. Put customizations in overlays/.

# Execution environment 'finance_ops' for 'ayc'.
# tier=minimal · network=allowlist · timeout=300s
# toolchains: data_analysis
# mounts: financial_records
#
# Egress is limited to: accounting.internal, flows.internal.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    ORGAGENTS_ENVIRONMENT=finance_ops

WORKDIR /workspace

# no additional packages for this environment class

COPY requirements.txt wheel[s] /wheels/
RUN if ls /wheels/*.whl >/dev/null 2>&1; then pip install --no-cache-dir /wheels/*.whl; fi \
 && pip install --no-cache-dir --find-links /wheels -r /wheels/requirements.txt

COPY agents/ /app/agents/
COPY system.ir.json /app/system.ir.json

RUN useradd --create-home --uid 10001 agent 2>/dev/null || true \
 && mkdir -p /workspace && chown -R agent /workspace /app
USER agent

CMD ["orgagents", "worker"]
