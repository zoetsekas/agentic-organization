# Generated by orgagents from the system spec 'ayc' (spec_version 1.3.0, ir 1.0.0).
# Do not edit: this file is regenerated on every compile. Put customizations in overlays/.

terraform {
  required_version = ">= 1.6"
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 6.0"
    }
  }
}

provider "google" {
  region = var.region
  # The tenant boundary on this provider: everything below is created inside
  # this one project, and an apply pointed elsewhere fails (ADR-0050).
  project = var.project
}

locals {
  system      = "ayc"
  environment = "development"
  tenant      = ""
  tenant_prefix = ""
  labels = {
    "managed-by"   = "orgagents"
    "system"       = "ayc"
    "tenant"       = ""
    "spec-version" = "1.3.0"
  }
}

resource "google_sql_database_instance" "ayc_state" {
  name = "${local.system}-state"
  # neutral resource: state_store — sessions, org, catalog
  region = var.region
}

resource "google_storage_bucket" "ayc_artifacts" {
  name = "${local.system}-artifacts"
  # neutral resource: object_store — session artifacts, sandbox outputs
  region = var.region
}

resource "google_pubsub_topic" "ayc_bus" {
  name = "${local.system}-bus"
  # neutral resource: message_bus — agent-to-agent asynchronous messaging
  region = var.region
}

resource "google_logging_project_sink" "ayc_telemetry" {
  name = "${local.system}-telemetry"
  # neutral resource: observability_sink — 
  region = var.region
}
