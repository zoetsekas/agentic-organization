# Do not edit: this file is regenerated on every compile. Put customizations in overlays/.

resource "google_cloud_scheduler_job" "nightly_stock_reconcile" {
  # Reconcile Shopify listings to Fishbowl stock overnight.
  # cron `0 2 * * *` (America/Los_Angeles) → listing_readiness
  # overlap=skip catch_up=skip_missed retries=2
  name             = "trigger-nightly_stock_reconcile"
  region = var.region
  schedule = "0 2 * * *"
  time_zone = "America/Los_Angeles"
  attempt_deadline = "900s"

  # Runs as the agent, not as the scheduler (ADR-0015).
  service_account = google_service_account.ecommerce_agent.email
}
