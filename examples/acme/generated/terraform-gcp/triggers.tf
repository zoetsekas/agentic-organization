resource "google_cloud_scheduler_job" "weekday_flash_report" {
  # Draft the daily revenue and cost flash before the day starts.
  # cron `0 7 * * 1-5` (Europe/London) → governed_data_request
  # overlap=skip catch_up=run_once retries=2
  name             = "trigger-weekday_flash_report"
  region = var.region
  schedule = "0 7 * * 1-5"
  time_zone = "Europe/London"
  attempt_deadline = "900s"

  # Runs as the agent, not as the scheduler (ADR-0015).
  service_account = google_service_account.analyst.email
}

resource "google_cloud_scheduler_job" "month_end_close_pack" {
  # Assemble the month-end close pack for the CFO to review.
  # cron `0 6 1 * *` (Europe/London) → cfo
  # overlap=queue catch_up=run_once retries=1
  name             = "trigger-month_end_close_pack"
  region = var.region
  schedule = "0 6 1 * *"
  time_zone = "Europe/London"
  attempt_deadline = "3600s"

  # Runs as the agent, not as the scheduler (ADR-0015).
  service_account = google_service_account.cfo.email
}

resource "google_eventarc_trigger" "incident_triage" {
  # Triage every incident the monitoring stack raises.
  # fires on event class 'service_health_alert' filtered by {'severity': ['sev1', 'sev2']}
  name             = "trigger-incident_triage"
  region = var.region
  service_account = google_service_account.sre.email
}

resource "google_cloud_scheduler_job" "permission_review" {
  # Quarterly review of what every agent may reach.
  # cron `0 9 1 */3 *` (Europe/London) → ceo
  # overlap=skip catch_up=skip_missed retries=2
  name             = "trigger-permission_review"
  region = var.region
  schedule = "0 9 1 */3 *"
  time_zone = "Europe/London"
  attempt_deadline = "900s"

  # Runs as the agent, not as the scheduler (ADR-0015).
  service_account = google_service_account.ceo.email
}

resource "google_eventarc_trigger" "finance_question" {
  # Answer a finance question asked in the approvals channel.
  # fires on event class '' filtered by {}
  name             = "trigger-finance_question"
  region = var.region
  service_account = google_service_account.analyst.email
}

resource "google_pubsub_topic" "dead_letter" {
  # Runs that exhaust their retries land here (ADR-0025).
  name = "acme-triggers-dlq"
