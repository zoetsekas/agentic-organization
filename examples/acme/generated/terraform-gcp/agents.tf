        limits = {
          cpu    = "0.25"
          memory = "512Mi"
        }
      }
      env {
        name  = "ORGAGENTS_AGENT_ID"
        value = "ceo"
      }
    }
  }

  labels = merge(local.labels, {
    "team"            = "acme"
    "network-posture" = "none"
  })
}

