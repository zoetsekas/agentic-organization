resource "google_cloud_scheduler_job" "premarket_risk_pack" {
  # Produce the morning risk pack before the floor opens.
  # cron `0 6 * * 1-5` (Europe/London) → morning_risk_pack
  # overlap=skip catch_up=skip_missed retries=2
  name             = "trigger-premarket_risk_pack"
  region = var.region
  schedule = "0 6 * * 1-5"
  time_zone = "Europe/London"
