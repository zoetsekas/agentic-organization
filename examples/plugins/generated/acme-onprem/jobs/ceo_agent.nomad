# Generated by orgagents from the system spec 'ayc' (spec_version 1.4.0, ir 1.0.0).
# Do not edit: this file is regenerated on every compile. Put customizations in overlays/.

job "ceo_agent" {
  datacenters = ["dc1"]
  type        = "service"

  meta {
    orgagents_system = "ayc"
    orgagents_agent  = "ceo_agent"
    team             = "AYC"
    reports_to       = ""
  }

  group "ceo_agent" {
    count = 1
    task "agent" {
      driver = "docker"
      config {
        image = "registry.acme.internal/orgagents-agent:latest"
      }
      env {
        ORGAGENTS_AGENT_ID = "ceo_agent"
        ORGAGENTS_MODEL    = "anthropic:claude-sonnet-5"
      }
    }
  }
}

