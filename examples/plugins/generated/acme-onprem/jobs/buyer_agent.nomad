# Generated by orgagents from the system spec 'ayc' (spec_version 1.4.0, ir 1.0.0).
# Do not edit: this file is regenerated on every compile. Put customizations in overlays/.

job "buyer_agent" {
  datacenters = ["dc1"]
  type        = "service"

  meta {
    orgagents_system = "ayc"
    orgagents_agent  = "buyer_agent"
    team             = "AYC / Operations / Purchasing"
    reports_to       = "coo_agent"
  }

  group "buyer_agent" {
    count = 1
    task "agent" {
      driver = "docker"
      config {
        image = "registry.acme.internal/orgagents-agent:latest"
      }
      env {
        ORGAGENTS_AGENT_ID = "buyer_agent"
        ORGAGENTS_MODEL    = "anthropic:claude-sonnet-5"
      }
    }
  }
}

# Carried by the design and NOT enforced by Nomad.
# Deploy an infrastructure target alongside if you need these held:
#   - mandate: may decide ['raise_po', 'receive_goods']
#   - 4 resolved permissions
#   - approval required for ['goods_receiving', 'purchase_ordering'] — Nomad has nowhere to route it
#   - sandbox 'warehouse_ops' (network allowlist)
