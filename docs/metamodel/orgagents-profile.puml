@startuml OrgAgentsProfile
hide empty members
skinparam classAttributeIconSize 0

class "Activity" as MC_ACTIVITY <<metaclass>>
class "Actor" as MC_ACTOR <<metaclass>>
class "Artifact" as MC_ARTIFACT <<metaclass>>
class "Class" as MC_CLASS <<metaclass>>
class "Class {isActive}" as MC_ACTIVE_CLASS <<metaclass>>
class "Comment" as MC_COMMENT <<metaclass>>
class "Component" as MC_COMPONENT <<metaclass>>
class "Constraint" as MC_CONSTRAINT <<metaclass>>
class "DataType" as MC_DATA_TYPE <<metaclass>>
class "Event" as MC_EVENT <<metaclass>>
class "ExecutionEnvironment" as MC_EXECUTION_ENVIRONMENT <<metaclass>>
class "Interface" as MC_INTERFACE <<metaclass>>
class "Node" as MC_NODE <<metaclass>>

class Team <<Team>>
Team ..> MC_COMPONENT : <<extends>>
class Agent <<Agent>>
Agent ..> MC_ACTIVE_CLASS : <<extends>>
class Subagent <<SubAgent>>
Subagent ..> MC_CLASS : <<extends>>
class Skill <<Skill>>
Skill ..> MC_ARTIFACT : <<extends>>
class Plugin <<Plugin>>
Plugin ..> MC_COMPONENT : <<extends>>
class Tool <<Tool>>
Tool ..> MC_INTERFACE : <<extends>>
class Person <<Person>>
Person ..> MC_ACTOR : <<extends>>
class Role <<Role>>
Role ..> MC_CLASS : <<extends>>
class Decision <<Decision>>
Decision ..> MC_DATA_TYPE : <<extends>>
class Separation <<Separation>>
Separation ..> MC_CONSTRAINT : <<extends>>
class Policy <<Policy>>
Policy ..> MC_CONSTRAINT : <<extends>>
class Capability <<Capability>>
Capability ..> MC_INTERFACE : <<extends>>
class DataClass <<DataClass>>
DataClass ..> MC_DATA_TYPE : <<extends>>
class Environment <<Environment>>
Environment ..> MC_EXECUTION_ENVIRONMENT : <<extends>>
class Endpoint <<Endpoint>>
Endpoint ..> MC_INTERFACE : <<extends>>
class Mission <<Mission>>
Mission ..> MC_COMPONENT : <<extends>>
class Workflow <<Workflow>>
Workflow ..> MC_ACTIVITY : <<extends>>
class Trigger <<Trigger>>
Trigger ..> MC_EVENT : <<extends>>
class Channel <<Channel>>
Channel ..> MC_NODE : <<extends>>
class Knowledge <<Knowledge>>
Knowledge ..> MC_ARTIFACT : <<extends>>
class MemoryNamespace <<MemoryNamespace>>
MemoryNamespace ..> MC_ARTIFACT : <<extends>>
class Guardrail <<Guardrail>>
Guardrail ..> MC_CONSTRAINT : <<extends>>
class OutputContract <<OutputContract>>
OutputContract ..> MC_CONSTRAINT : <<extends>>
class Evaluation <<Evaluation>>
Evaluation ..> MC_CONSTRAINT : <<extends>>
class Note <<Note>>
Note ..> MC_COMMENT : <<extends>>

Team "0..1" *-- "0..*" Team : contains [teams]
Team "1" *-- "0..*" Agent : member [members]
Agent "1" *-- "0..*" Subagent : uses [subagents]
Agent "0..*" ..> "0..*" Environment : <<deploy>> runs in [environments]
Agent "0..*" --> "0..*" Knowledge : consults [knowledge]
Agent "0..*" ..|> "0..*" Capability : provides [capabilities]
Agent "0..*" --> "0..*" Role : plays [roles]
Agent "0..*" --> "0..*" Skill : holds [skills]
Agent "0..*" --> "0..*" Plugin : holds [plugins]
Agent "0..*" --> "0..*" Tool : holds [tools]
Agent "0..*" ..> "0..*" Endpoint : <<use>> calls [endpoints]
Agent "0..*" ..> "0..*" Workflow : <<use>> runs [workflows]
Agent "0..*" --> "0..*" DataClass : produces [produces_data]
Agent "0..*" ..> "0..*" DataClass : relies on [data_dependencies]
Agent "0..*" --> "0..*" Person : paired with [humans]
Agent "0..*" --> "0..*" Guardrail : guarded by [guardrails]
Agent "0..*" --> "0..1" OutputContract : returns [output_contract]
Agent "0..*" --> "0..1" Agent : successor [successor]
Team "0..*" --> "0..1" Agent : leads [leader]
Agent "0..*" ..> "0..*" Agent : flow [interaction_flows]
Team "0..*" --> "0..*" Team : unit link [unit_links]
Trigger "0..*" ..> "1" Agent : fires [agent]
Trigger "0..*" ..> "0..1" Workflow : starts [workflow]
Role "0..*" --> "0..*" Capability : grants [capabilities]
Capability "0..*" --> "0..*" DataClass : reaches [data_classes]
Knowledge "0..*" --> "0..*" DataClass : contains [data_classes]
MemoryNamespace "0..*" --> "0..*" DataClass : stores [data_classes]
Guardrail "0..*" --> "0..*" DataClass : protects [data_classes]
Endpoint "0..*" --> "0..*" DataClass : may receive [send_data_classes]
Skill "0..*" ..> "0..*" Capability : requires [requires_capabilities]
Plugin "0..*" ..> "0..*" Capability : requires [requires_capabilities]
Plugin "0..*" --> "0..*" Skill : provides [provides_skills]
Plugin "0..*" --> "0..*" Tool : provides [provides_tools]
Separation "0..*" --> "2..*" Decision : keeps apart [decisions]
Evaluation "0..*" --> "0..*" Agent : evaluates [applies_to]
Channel "0..*" --> "0..*" Agent : includes [members]
Mission "0..*" --> "0..*" Agent : includes [members]
Subagent "0..*" ..|> "0..*" Capability : provides [capabilities]
Subagent "0..*" --> "0..*" Knowledge : consults [knowledge]
@enduml
