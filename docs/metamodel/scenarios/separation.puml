@startuml separation
!pragma layout smetana
title Give one agent both halves of a separation
object "ops_lead : Agent" as agent_ops_lead
object "four_eyes : Separation" as separation_four_eyes
object "acme : Organization" as organization_acme {
  leader = ceo
}
object "secure : Environment" as environment_secure
object "payer : Role" as role_payer
object "ops : Team" as team_ops {
  leader = ops_lead
}
object "approve_payment : Decision" as decision_approve_payment
object "release_payment : Decision" as decision_release_payment
object "analyst : Agent" as agent_analyst
organization_acme *-- separation_four_eyes : owns
agent_ops_lead ..> environment_secure : runs in
agent_ops_lead --> role_payer : plays
team_ops *-- agent_ops_lead : member
team_ops --> agent_ops_lead : leads
separation_four_eyes --> decision_approve_payment : keeps apart
separation_four_eyes --> decision_release_payment : keeps apart
agent_ops_lead --> agent_analyst : delegate
@enduml
