@startuml share_knowledge
!pragma layout smetana
title Share one knowledge source between agents
object "analyst : Agent" as agent_analyst
object "risk_lead : Agent" as agent_risk_lead
object "handbook : Knowledge" as knowledge_handbook
object "acme : Organization" as organization_acme {
  leader = ceo
}
object "sandbox : Environment" as environment_sandbox
object "read_ledger : Capability" as capability_read_ledger
object "ops : Team" as team_ops {
  leader = ops_lead
}
object "risk : Team" as team_risk {
  leader = risk_lead
}
object "nightly : Trigger" as trigger_nightly
object "ops_lead : Agent" as agent_ops_lead
organization_acme *-- knowledge_handbook : owns
agent_analyst ..> environment_sandbox : runs in
agent_analyst --> knowledge_handbook : consults
agent_analyst ..> capability_read_ledger : provides
agent_risk_lead --> knowledge_handbook : consults
agent_risk_lead ..> capability_read_ledger : provides
team_ops *-- agent_analyst : member
team_risk *-- agent_risk_lead : member
team_risk --> agent_risk_lead : leads
trigger_nightly --> agent_analyst : fires
agent_ops_lead --> agent_analyst : delegate
@enduml
